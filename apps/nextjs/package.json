{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @codeqr/analytics... build && next build",
    "build:script": "pnpm --filter @codeqr/analytics-script build && rm -rf public/analytics && mkdir -p public/analytics && cp -R ../../packages/script/dist/analytics/. public/analytics/",
    "dev": "next dev",
    "lint": "next lint",
    "start": "next start",
    "test": "playwright test",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@codeqr/analytics": "workspace:*",
    "next": "16.2.12",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "eslint": "^10",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "typescript": "^7"
  }
}